{
  "name": "caixa-por-conversa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import=tsx --watch src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "simulate": "node --env-file=.env dist/simulator.js",
    "db:check": "node --env-file=.env scripts/check-db.mjs",
    "db:secure": "node --env-file=.env scripts/provision-app-role.mjs",
    "db:secure:test": "node --env-file=.env.test scripts/provision-app-role.mjs --test",
    "db:migrate": "node --env-file=.env.admin scripts/apply-schema.mjs",
    "test": "npm run build && node --test test/assistant.test.mjs test/database-target.test.mjs",
    "test:db": "npm run build && node scripts/run-db-tests.mjs",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
