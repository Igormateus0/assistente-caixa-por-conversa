# Credenciais exclusivamente de um PostgreSQL de TESTE separado do banco do app.
# Comece apenas com DATABASE_TEST_ADMIN_URL; db:secure:test cria o papel app de teste.
DATABASE_TEST_ADMIN_URL="postgresql://postgres:SENHA_DO_BANCO_DE_TESTE@HOST_DO_BANCO_DE_TESTE:5432/postgres?sslmode=require"
# DATABASE_TEST_URL será preenchida por npm.cmd run db:secure:test.
